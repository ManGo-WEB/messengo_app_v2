# Локальная разработка. Скопируйте в .env и заполните: cp .env.example .env
# DATABASE_URL должен соответствовать POSTGRES_* ниже.

# PostgreSQL (docker-compose.yaml, сервис db; порт публикуется только на localhost)
POSTGRES_USER=messengo
POSTGRES_DB=messengo
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# Подключение для миграций и приложения
DATABASE_URL=postgresql://messengo:replace-with-a-local-password@localhost:5432/messengo

# Секрет сессий аутентификации (32+ случайных символов)
AUTH_SECRET=replace-with-32-or-more-random-characters

# Базовый URL приложения (для куки и origin-проверок Better Auth; в проде — https://…)
AUTH_BASE_URL=http://localhost:3000

# Ключ шифрования секретов каналов (32 байта в base64) для ChannelConnection.config.
# Не менять после того, как подключения сохранены, — секреты станут нечитаемыми.
CHANNEL_SECRET_KEY=replace-with-base64-32-bytes

# Почта для писем «напомнить пароль»: console (dev — письмо в лог) или smtp (прод)
MAIL_TRANSPORT=console
SMTP_URL=
MAIL_FROM=Messengo <no-reply@messengo.ru>

# VK-приложение (B1; создать по docs/runbooks/vk.md)
VK_APP_ID=
VK_APP_SECRET=
VK_REDIRECT_URL=http://localhost:3000/api/channels/vk/callback
VK_WEBHOOK_URL=http://localhost:3000/api/webhooks/vk

# Telegram: токен СЛУЖЕБНОГО бота для личного Secretary Mode (B3; создать по docs/runbooks/telegram-personal.md)
TELEGRAM_PERSONAL_BOT_TOKEN=
TELEGRAM_PERSONAL_WEBHOOK_URL=http://localhost:3000/api/webhooks/telegram

# Meta-приложение (B4, Facebook Messenger + Instagram Direct; создать по docs/runbooks/meta.md)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_REDIRECT_URL=http://localhost:3000/api/channels/meta/callback
