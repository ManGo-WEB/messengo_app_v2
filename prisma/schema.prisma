// Messengo V2 — базовая модель данных (пункт A2 плана).
// Все тенантные данные несут organizationId; удаление Organization каскадно
// удаляет данные организации.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum ChannelType {
  VK
  TELEGRAM_BOT
  TELEGRAM_PERSONAL
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  MAX
  TESTING
}

enum ChannelStatus {
  PENDING
  ACTIVE
  ERROR
  DISCONNECTED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageStatus {
  RECEIVED
  PENDING
  SENT
  FAILED
  UNKNOWN
}

// PENDING — ждёт отправки; PROCESSING — атомарно захвачен воркером;
// SENT — доставлен; FAILED — попытки исчерпаны (A4).
enum OutboxJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum AttemptResult {
  SENT
  FAILED
  UNKNOWN
}

enum DraftSource {
  MANUAL
  AI
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users         User[]
  connections   ChannelConnection[]
  conversations Conversation[]
  contacts      Contact[]
  messages      Message[]
  inboundEvents InboundEvent[]
  outboxJobs    OutboxJob[]
  drafts        Draft[]
}

// User/Session/Account/Verification — модели Better Auth; пароль хранится
// только хешем в Account.password (credential-провайдер), поле passwordHash
// в User не используется.
model User {
  id             String       @id @default(uuid())
  email          String       @unique
  name           String
  image          String?
  emailVerified  Boolean      @default(false)
  organizationId String
  role           UserRole     @default(ADMIN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions       Session[]
  accounts       Account[]

  @@index([organizationId])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model ChannelConnection {
  id             String         @id @default(uuid())
  organizationId String
  type           ChannelType
  externalId     String
  // Человекочитаемое имя подключения (сообщество/бот/страница) — отдаёт GET /api/channels (B5)
  displayName    String?
  status         ChannelStatus @default(PENDING)
  // Секреты канала хранятся только зашифрованными (CHANNEL_SECRET_KEY), в открытых логах не печатаются.
  config         Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversations  Conversation[]
  contacts       Contact[]
  inboundEvents  InboundEvent[]

  @@index([organizationId])
}

model Contact {
  id             String            @id @default(uuid())
  organizationId String
  connectionId   String
  externalId     String
  name           String?
  avatarUrl      String?
  connection     ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversations Conversation[]

  @@unique([connectionId, externalId])
  @@index([organizationId])
}

model Conversation {
  id             String            @id @default(uuid())
  organizationId String
  connectionId   String
  contactId      String
  // Внешний ключ диалога в канале (externalChatId по терминологии V1) —
  // ключ upsert'а в пайплайне приёма B0.
  externalKey    String?
  threadTitle    String?
  lastMessageAt  DateTime?
  connection     ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contact        Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  messages Message[]
  drafts   Draft[]

  @@unique([connectionId, externalKey])
  @@index([organizationId, lastMessageAt])
}

model Message {
  id             String           @id @default(uuid())
  organizationId String
  conversationId String
  direction      MessageDirection
  text           String
  status         MessageStatus    @default(PENDING)
  externalId     String?
  createdAt      DateTime         @default(now())
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  outboxJob OutboxJob?

  @@index([conversationId, externalId])
  @@index([organizationId])
}

// Сырые события каналов; уникальность (connectionId, externalEventId)
// обеспечивает идемпотентность повторных вебхуков.
model InboundEvent {
  id              String            @id @default(uuid())
  organizationId  String
  connectionId    String
  externalEventId String
  payload         Json
  processedAt     DateTime?
  connection      ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalEventId])
  @@index([organizationId])
}

model OutboxJob {
  id             String          @id @default(uuid())
  organizationId String
  messageId      String          @unique
  // Тип задания = ключ реестра обработчиков src/worker/handlers.ts
  type           String          @default("echo")
  attempts       Int             @default(0)
  status         OutboxJobStatus @default(PENDING)
  nextAttemptAt  DateTime        @default(now())
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  message        Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  attemptsLog SendAttempt[]

  @@index([status, nextAttemptAt])
  @@index([organizationId])
}

// Единственная строка (id="worker"): метка живости фонового воркера для /api/health
model WorkerHeartbeat {
  id        String   @id
  updatedAt DateTime
}

// Запрос на удаление данных канала (обязателен для Meta App Review, B4)
model MetaDeletionRequest {
  id           String    @id @default(uuid())
  code         String    @unique
  connectionId String?
  status       String    @default("PENDING") // PENDING | CONFIRMED
  createdAt    DateTime  @default(now())
  confirmedAt  DateTime?
}

model SendAttempt {
  id          String        @id @default(uuid())
  outboxJobId String
  result      AttemptResult
  detail      String?
  createdAt   DateTime      @default(now())
  outboxJob   OutboxJob     @relation(fields: [outboxJobId], references: [id], onDelete: Cascade)

  @@index([outboxJobId])
}

model Draft {
  id             String       @id @default(uuid())
  organizationId String
  conversationId String
  text           String
  revision       Int          @default(1)
  source         DraftSource  @default(MANUAL)
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, conversationId])
}
